--- a/boards/stm32h7a3/nucleo-h7a3zi-q/src/stm32_bringup.c
+++ b/boards/stm32h7a3/nucleo-h7a3zi-q/src/stm32_bringup.c
@@ -25,6 +25,7 @@
  ****************************************************************************/
 
 #include <nuttx/config.h>
+#include <nuttx/lcd/lcd_dev.h>
 
 #include <sys/types.h>
 #include <syslog.h>
@@ -412,5 +413,22 @@ int stm32_bringup(void)
   stm32_iwdginitialize("/dev/watchdog0", STM32_LSI_FREQUENCY);
 #endif
 
+#ifdef CONFIG_LCD_DEV
+  /* Initialize the SSD1306 OLED and register /dev/lcd0 */
+  ret = board_lcd_initialize();
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: board_lcd_initialize failed: %d\n", ret);
+    }
+  else
+    {
+      ret = lcddev_register(0);
+      if (ret < 0)
+        {
+          syslog(LOG_ERR, "ERROR: lcddev_register failed: %d\n", ret);
+        }
+    }
+#endif /* CONFIG_LCD_DRIVER */
+
   return OK;
 }
